# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any level — local tooling keeps its own)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# cloudflare local secrets
.dev.vars

# local-only tooling and its output — the showcase recorder that captures the
# project screenshots. Not part of the site, not needed to build or deploy.
/tools/

# asset-generation masters (icons, opengraph) — inputs to the committed
# icon/opengraph files, not needed by the build
/.icon-src/

# browser-automation scratch output
/.playwright-mcp/
